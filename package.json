{
  "name": "texture-lab",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Texture Lab v0.3 responsive vector texture composition canvas",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --config vitest.config.ts --project node",
    "pretest:e2e": "vite build",
    "test:e2e": "playwright test --config playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "playwright:install": "playwright install chromium"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.28.5",
    "@babel/preset-react": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "^4.13.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-prettier": "5.4.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "prettier": "3.9.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "5.0.0-beta.7"
  }
}
